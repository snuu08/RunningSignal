# demo preserves the existing experience; real uses actual GPS and configured providers.
# Netlify production builds set VITE_APP_MODE=real in netlify.toml.
VITE_APP_MODE=real
# Public browser keys only. Restrict MapTiler key to approved HTTP origins.
# If the current origin is not allowed, the map falls back to OpenFreeMap.
VITE_MAPTILER_KEY=
VITE_MAPTILER_STYLE=dataviz-dark
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# After keys are set: Dashboard → Authentication → URL Configuration
# Site URL and Redirect URLs must include http://localhost:<vite-port>/real/auth
# and the production origin /real/auth.
# Enable Kakao and Google under Authentication → Providers.
# Kakao Redirect URI and Google Authorized redirect URI:
# https://<project-ref>.supabase.co/auth/v1/callback
# Never put Kakao REST or client secrets in VITE_ vars.
# Server only. Never prefix these with VITE_. Do not paste keys from chat/history.
# Netlify: Site configuration → Environment variables
# Scope: Production, Deploy previews, Branch deploys.
# Same names as below. Build-time: VITE_* only. Functions runtime: unprefixed server keys.
# Do not add VITE_TMAP_APP_KEY or VITE_KAKAO_REST_API_KEY.
KAKAO_REST_API_KEY=
TMAP_APP_KEY=
SEOUL_TDATA_API_KEY=
# Reserved until approved provider specifications and responses are validated.
UTIC_SERVICE_KEY=
DATA_GO_KR_SERVICE_KEY=
# Optional. Never enables city-wide prediction by itself.
# Example scopes: field:1537,tdata:1537
SIGNAL_PREDICTION_SCOPES=
SIGNAL_PUBLIC_PREDICTION=false
# SIGNAL_VERIFIED_PATH=data/signals/verified/bundle.json
# SIGNAL_VERIFIED_JSON=
